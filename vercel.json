{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": false,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/servicios/",
      "destination": "/servicios/index.html"
    },
    {
      "source": "/pricing/",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/crm/",
      "destination": "/crm/index.html"
    },
    {
      "source": "/business-management/",
      "destination": "/business-management/index.html"
    },
    {
      "source": "/proyectos/",
      "destination": "/proyectos/index.html"
    },
    {
      "source": "/sitios-web/",
      "destination": "/sitios-web/index.html"
    },
    {
      "source": "/sistemas/",
      "destination": "/sistemas/index.html"
    },
    {
      "source": "/seo/",
      "destination": "/seo/index.html"
    },
    {
      "source": "/automatizacion/",
      "destination": "/automatizacion/index.html"
    },
    {
      "source": "/empresa/",
      "destination": "/empresa/index.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog/index.html"
    },
    {
      "source": "/privacidad/",
      "destination": "/privacidad/index.html"
    },
    {
      "source": "/condiciones/",
      "destination": "/condiciones/index.html"
    },
    {
      "source": "/faq/",
      "destination": "/faq/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/precios/",
      "destination": "/pricing/",
      "permanent": true
    }
  ]
}
