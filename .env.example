# Server-side secrets: set in Vercel project settings, NEVER prefix with PUBLIC/VITE.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_KEY
# Public publishable key (not a secret): used for simple email/password CRM login.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# The admin reads the public URL/key from /api/crm-public-config.
# Only this publishable key may be sent to browsers; RLS still protects the data.

# Production launch only, after applying Supabase CRM rate limiter migration and RLS checks.
# CRM_CAPTURE_ENABLED=true
# CRM_RATE_LIMIT_ENABLED=true
