# Server-side secrets: set in Vercel project settings, NEVER prefix with PUBLIC/VITE.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_KEY
# Public Supabase URL / anon key are entered in CRM admin settings at runtime.
# The public anon key is restricted by Supabase row-level security.
