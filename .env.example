# Server-side secrets: set in Vercel project settings, NEVER prefix with PUBLIC/VITE.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_KEY
# Public Supabase URL / publishable key are entered in CRM admin settings at runtime.
# The public publishable key is restricted by Supabase row-level security.
